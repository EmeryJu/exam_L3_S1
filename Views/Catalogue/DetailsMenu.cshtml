@model BrasilBurger.Models.Menu

@{
    ViewData["Title"] = "Détails Menu";
}

<h1>@Model.Nom</h1>

<div class="row">
    <div class="col-md-6">
        <img src="@Model.Image" class="img-fluid" alt="@Model.Nom">
    </div>
    <div class="col-md-6">
        <h3>Prix: @Model.Prix €</h3>
        <p>Composé de:</p>
        <ul>
            <li>@Model.Burger.Nom</li>
            @foreach (var mc in Model.MenuComplements)
            {
                <li>@mc.Complement.Nom</li>
            }
        </ul>
        <a href="@Url.Action("Commander", "Commande", new { menuId = Model.Id })" class="btn btn-success">Commander ce Menu</a>
        <a href="@Url.Action("Index", "Catalogue")" class="btn btn-secondary">Retour au Catalogue</a>
    </div>
</div>