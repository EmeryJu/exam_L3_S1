@model BrasilBurger.Controllers.CommanderViewModel

@{
    ViewData["Title"] = "Commander";
}

<h1>Commander</h1>

@if (Model.Burger != null)
{
    <h2>@Model.Burger.Nom - @Model.Burger.Prix €</h2>
}
else if (Model.Menu != null)
{
    <h2>@Model.Menu.Nom - @Model.Menu.Prix €</h2>
}

<form asp-action="Commander" method="post">
    <div class="form-group">
        <label>Compléments supplémentaires</label>
        @foreach (var comp in Model.Complements)
        {
            <div class="form-check">
                <input class="form-check-input" type="checkbox" name="SelectedComplements" value="@comp.Id" id="comp@comp.Id">
                <label class="form-check-label" for="comp@comp.Id">
                    @comp.Nom - @comp.Prix €
                </label>
            </div>
        }
    </div>

    <div class="form-group">
        <label asp-for="TypeCommande">Type de commande</label>
        <select asp-for="TypeCommande" class="form-control">
            <option value="SurPlace">À consommer sur place</option>
            <option value="Recuperer">À récupérer</option>
            <option value="Livre">À livrer</option>
        </select>
    </div>

    <div class="form-group" id="zoneGroup" style="display: none;">
        <label asp-for="ZoneId">Zone de livraison</label>
        <select asp-for="ZoneId" class="form-control">
            <option value="">Sélectionner une zone</option>
            @foreach (var zone in Model.Zones)
            {
                <option value="@zone.Id">@zone.Nom - @zone.PrixLivraison €</option>
            }
        </select>
    </div>

    <div class="form-group">
        <label asp-for="MethodePaiement">Méthode de paiement</label>
        <select asp-for="MethodePaiement" class="form-control">
            <option value="Wave">Wave</option>
            <option value="OM">Orange Money</option>
        </select>
    </div>

    <h3>Informations client</h3>
    <div class="form-group">
        <label asp-for="ClientNom">Nom</label>
        <input asp-for="ClientNom" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="ClientPrenom">Prénom</label>
        <input asp-for="ClientPrenom" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="ClientTelephone">Téléphone</label>
        <input asp-for="ClientTelephone" class="form-control" required />
    </div>
    <div class="form-group">
        <label asp-for="ClientEmail">Email</label>
        <input asp-for="ClientEmail" class="form-control" type="email" required />
    </div>

    <button type="submit" class="btn btn-primary">Confirmer la commande</button>
</form>

<script>
    document.getElementById('TypeCommande').addEventListener('change', function() {
        var zoneGroup = document.getElementById('zoneGroup');
        if (this.value === 'Livre') {
            zoneGroup.style.display = 'block';
        } else {
            zoneGroup.style.display = 'none';
        }
    });
</script>